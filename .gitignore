/build/
# ... and the per-toolkit build dirs (build-gtk3/, build-gtk4/) used while the
# gtkmm-3 and gtkmm-4 builds are kept side by side.
/build-*/
# Downloaded model artifacts — reproducible from config/models.conf, so they
# are never committed. Locally compiled ones (the `source = local` entries)
# have to be dropped back in by hand after a fresh clone.
/models/
*.o
*.user
compile_commands.json
hailort*.log
# Vendor benchmark tools write their reports to the *current directory*, so a
# cross-check run from the repo root litters it. Run them from a scratch dir;
# these patterns are a backstop.
DXBENCHMARK_*.csv
DXBENCHMARK_*.html
DXBENCHMARK_*.json
profiler.json

# CSV logs written by the app (always on; <exe>/../logs/).
logs/
# log files and html reports
*.log
*.html

# Python bytecode from tools/.
__pycache__/
