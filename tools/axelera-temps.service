# Clear both gates that Axelera Metis core temperatures depend on, at boot.
#
# Needed because the card's runtime firmware is RAM-only and nothing loads it at
# startup: after every reboot the Metis sits in bootloader firmware with its
# collector at the default `err` level, so `core_temps=[...]` is never emitted
# and mb-benchmark-gui / mb-powermon-gui show the Axelera row with no values.
#
# SCOPE — read this before expecting it to do much. The script no longer loads
# firmware; it only sets the collector log level. On a cold boot the Metis is in
# bootloader, so this unit will report that and exit 0 with temperatures still
# unavailable. They appear once something runs a model, which is what loads the
# firmware safely — after that, re-run the script (or just let the next boot
# service run pick it up if a model has already run).
#
# Firmware is deliberately NOT uploaded here. `axcmd --fwload` leaves the card in
# a state where inference fails on the second frame with ZE_RESULT_ERROR_DEVICE_
# LOST and needs a power cycle; see the long note in axelera-temps.sh.
#
# The collector level is also volatile: it resets on a driver reload
# (modprobe -r metis) as well as on reboot, and this unit is Type=oneshot with
# RemainAfterExit, so it will still read "active" while temperatures are gone.
# Re-run by hand after any modprobe cycle:
#   sudo /usr/local/sbin/axelera-temps.sh
#
# Install:
#   sudo install -m 755 tools/axelera-temps.sh /usr/local/sbin/axelera-temps.sh
#   sudo cp tools/axelera-temps.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now axelera-temps.service
#   systemctl status axelera-temps.service
#
# After editing tools/axelera-temps.sh, re-run the `install` line — the running
# copy is /usr/local/sbin's, not the repo's.
#
# Undo:
#   sudo systemctl disable --now axelera-temps.service
#   sudo rm /etc/systemd/system/axelera-temps.service /usr/local/sbin/axelera-temps.sh

[Unit]
Description=Axelera Metis: enable the temperature collector
Documentation=https://github.com/AlbertaBeef/mb-benchmark-gui
# Ordering only. The node is created by the metis driver, not by this service,
# and the script waits up to 30 s for /dev/metis-* itself — so this is belt and
# braces rather than a real dependency.
#
# Note: on a single-chip M.2 Metis, axelera-multi-device.service FAILS on every
# boot (status=255 — it runs `axl-switchtec list`, and there is no PCIe switch
# to find). That is normal here and does not affect this unit: Wants= does not
# propagate failure. Don't go debugging it because you saw it red in the journal.
After=axelera-multi-device.service
Wants=axelera-multi-device.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/axelera-temps.sh
# Both settings live in volatile device state, so this runs once per boot and
# there is nothing to keep alive afterwards.
RemainAfterExit=yes
# The device node is 0666, so root is not strictly required — but at boot this
# runs before any user session exists, so root is the reliable choice.

[Install]
WantedBy=multi-user.target
